{
  "$schema": "./node_modules/@intisy/bayonet/schema/plugin.schema.json",
  "id": "custom-auth",
  "api": 1,
  "entry": "dist/index.js",
  "displayName": "Custom endpoints",
  "capabilities": [
    "provider",
    "custom-endpoints",
    "settings"
  ],
  "services": {
    "consumes": [
      "provider-support"
    ]
  },
  "config": {
    "defaults": {
      "endpoints": []
    }
  },
  "publish": {
    "scopedOnly": true
  },
  "repo": {
    "role": "Custom user-endpoint provider",
    "category": "ai-provider",
    "tech": [
      "typescript"
    ]
  },
  "marketplace": {
    "categories": [
      {
        "id": "translators",
        "label": "Translators",
        "match": {
          "topics": [
            "vendor-translator"
          ]
        }
      }
    ]
  }
}
